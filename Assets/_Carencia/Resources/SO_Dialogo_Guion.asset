%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ceac3d428ed9ab3498835221b29c47f8, type: 3}
  m_Name: SO_Dialogo_Guion
  m_EditorClassIdentifier: 
  fuente: {fileID: 11400000, guid: a7f2db7fa2beff24ca8b5b4eca4fcf6d, type: 2}
  sonidoEscritura: {fileID: 8300000, guid: aae8af69a74264a46b01880b117cdfe8, type: 3}
  letrasPorSegundo: 40
  lineas:
  - clave: P1_mama
    quien: "Mam\xE1"
    texto: "Elaki, vamos a comer."
    pensamiento: 0
  - clave: P2_periodico
    quien: ""
    texto: "SE VENDE Tsuru 2009, buenas condiciones. Informes al\u2026"
    pensamiento: 0
  - clave: P2_elaki_1
    quien: "Elaki"
    texto: "\xBFPor qu\xE9 no le pusieron su plato a M-M-A-A-R?"
    pensamiento: 0
  - clave: P2_elaki_2
    quien: "Elaki"
    texto: "\xBFD\xF3nde est\xE1 M-M-A-A-R?"
    pensamiento: 0
  - clave: P2_madre_1
    quien: "Mam\xE1"
    texto: "Hijo\u2026 t\xFA nunca tuviste hermana."
    pensamiento: 0
  - clave: P2_padre_1
    quien: "Pap\xE1"
    texto: "Termina tu desayuno y vuelve a la cama."
    pensamiento: 0
  - clave: P2_elaki_3
    quien: "Elaki"
    texto: "Pero\u2026 \xBFc\xF3mo?\u2026 Mi hermana\u2026"
    pensamiento: 0
  - clave: P3_pensamiento
    quien: "Elaki"
    texto: "Necesito echarme agua en la cara."
    pensamiento: 1
  - clave: P4_lavabo_1
    quien: "Elaki"
    texto: "Ya me siento mejor\u2026 creo."
    pensamiento: 1
  - clave: P4_lavabo_2
    quien: "Elaki"
    texto: ""
    pensamiento: 1
  - clave: P4_toallas_1
    quien: "Elaki"
    texto: "La m\xEDa, la de mam\xE1, la de pap\xE1\u2026 y la de ella."
    pensamiento: 1
  - clave: P4_toallas_2
    quien: "Elaki"
    texto: "Cuatro."
    pensamiento: 1
  - clave: P4_cortina
    quien: "Elaki"
    texto: "Est\xE1 cerrada. Mejor as\xED."
    pensamiento: 1
  - clave: R_puerta_cerrada
    quien: "Elaki"
    texto: "Est\xE1 cerrada."
    pensamiento: 1
  - clave: P5_SertralinaCajas
    quien: "Elaki"
    texto: "El medicamento de mam\xE1."
    pensamiento: 1
  - clave: P5_SertralinaFrasco
    quien: "Elaki"
    texto: "\xBFPor qu\xE9 estoy tan nervioso?"
    pensamiento: 1
  - clave: P5_ClorpromazinaBote
    quien: "Elaki"
    texto: "No siempre funcionan."
    pensamiento: 1
  - clave: P5_ClorpromazinaFrasco
    quien: "Elaki"
    texto: "Las tomo todas las noches\u2026 creo."
    pensamiento: 1
  - clave: P5_Risperidona
    quien: "Elaki"
    texto: "Las tomo todas las noches\u2026 creo."
    pensamiento: 1
  - clave: P5_Blister
    quien: "Elaki"
    texto: "Estas saben muy amargas."
    pensamiento: 1
  - clave: P5_Pads
    quien: "Elaki"
    texto: "\xBFQui\xE9n compr\xF3 estos?"
    pensamiento: 1
  - clave: P5_Rastrillo
    quien: "Elaki"
    texto: ""
    pensamiento: 1
  - clave: REF_Frijoles
    quien: "Elaki"
    texto: "La olla con frijoles de hace dos semanas. Mejor ni la destapo."
    pensamiento: 1
  - clave: REF_AguaJamaica
    quien: "Elaki"
    texto: "Agua de jamaica. Ya ni sabe a nada."
    pensamiento: 1
  - clave: REF_Arroz
    quien: "Elaki"
    texto: "Arroz de\u2026 no s\xE9 de cu\xE1ndo."
    pensamiento: 1
  - clave: REF_Huevos
    quien: "Elaki"
    texto: "Huevos. Tendr\xEDa que cocinar. Mmm, no."
    pensamiento: 1
  - clave: REF_Pay
    quien: "Elaki"
    texto: "Un pedazo de pay. No tengo ganas."
    pensamiento: 1
  - clave: REF_Jitomates
    quien: "Elaki"
    texto: "Esto mmm\u2026 no me gusta tanto."
    pensamiento: 1
  - clave: REF_Refresco
    quien: "Elaki"
    texto: "Refresco sin gas. Como todo."
    pensamiento: 1
  - clave: P6_pensamiento_1
    quien: "Elaki"
    texto: "\xBFElla\u2026 se fue por ah\xED?"
    pensamiento: 1
  - clave: P6_pensamiento_2
    quien: "Elaki"
    texto: "Si cruzo, tal vez la encuentre."
    pensamiento: 1
  - clave: N1_1_toallas_1
    quien: "Elaki"
    texto: "Son todas iguales\u2026 menos una."
    pensamiento: 1
  - clave: N1_1_toallas_2
    quien: "Elaki"
    texto: "Esa es la de ella."
    pensamiento: 1
  - clave: N1_1_gabinete_1
    quien: "Elaki"
    texto: "No entiendo lo que dicen."
    pensamiento: 1
  - clave: N1_1_gabinete_2
    quien: "Elaki"
    texto: "Antes s\xED se pod\xEDan leer."
    pensamiento: 1
  - clave: N1_1_cortina_1
    quien: "Elaki"
    texto: "\xBFDeber\xEDa ir?"
    pensamiento: 1
  - clave: N1_1_puerta
    quien: "Elaki"
    texto: "Qu\xE9 extra\xF1o\u2026 no se abre."
    pensamiento: 1
  - clave: N1_2_calendario_1
    quien: "Elaki"
    texto: "31 de octubre."
    pensamiento: 1
  - clave: N1_2_calendario_2
    quien: "Elaki"
    texto: "Se qued\xF3 en el 31."
    pensamiento: 1
  - clave: N1_3_cama
    quien: "Elaki"
    texto: "Es mi cuarto\u2026 \xBFo no?"
    pensamiento: 1
  - clave: N1_4_pared
    quien: "Elaki"
    texto: "Esta pared no estaba aqu\xED."
    pensamiento: 1
  - clave: N1_4_sillas_1
    quien: "Elaki"
    texto: "Cuatro sillas."
    pensamiento: 1
  - clave: N1_4_sillas_2
    quien: "Elaki"
    texto: "No hay mesa."
    pensamiento: 1
  - clave: N1_4_ya_pase
    quien: "Elaki"
    texto: "Ya pas\xE9 por aqu\xED."
    pensamiento: 1
  - clave: N1_5_pensamiento
    quien: "Elaki"
    texto: "\xBFM-M-A-A-R?"
    pensamiento: 1
  - clave: N1_6_ayuda
    quien: "Voz"
    texto: "Ayuda."
    pensamiento: 0
  - clave: N1_7_pensamiento
    quien: "Elaki"
    texto: "\xBFQu\xE9 pas\xF3 ayer\u2026? Esto es muy extra\xF1o."
    pensamiento: 1
  - clave: N1_8_periodico
    quien: ""
    texto: "Pante\xF3n Rococ\xF3 dedica su Tiny Desk a las personas desaparecidas\n\n\xABTe extra\xF1o, siempre te busco. Alg\xFAn d\xEDa nos encontraremos de nuevo\xBB, dijo el vocalista.\n\nTocaron Arr\xE9glame el alma, 1993\u2026, Cha-Cha Love, La dosis perfecta y La carencia."
    pensamiento: 0
  - clave: N1_8_madre_1
    quien: "Mam\xE1"
    texto: "\xBFC\xF3mo te sientes hoy, hijo?"
    pensamiento: 0
  - clave: N1_8_elaki_1
    quien: "Elaki"
    texto: "Bien."
    pensamiento: 0
  - clave: N1_8_elaki_piensa
    quien: "Elaki"
    texto: "Si les cuento, no me van a creer."
    pensamiento: 1
  - clave: N2_1_pensamiento
    quien: "Elaki"
    texto: "Necesito seguir busc\xE1ndola."
    pensamiento: 1
  - clave: N2_2_toallas_1
    quien: "Elaki"
    texto: "Solo hay tres."
    pensamiento: 1
  - clave: N2_2_toallas_2
    quien: "Elaki"
    texto: "Alguien quit\xF3 la suya."
    pensamiento: 1
  - clave: N2_2_tina
    quien: "Elaki"
    texto: "Nunca reparan esa gotera."
    pensamiento: 1
  - clave: N2_2_gabinete
    quien: "Elaki"
    texto: "Los parches siguen aqu\xED."
    pensamiento: 1
  - clave: N2_3_toallas
    quien: "Elaki"
    texto: "Est\xE1n tiesas de mugre."
    pensamiento: 1
  - clave: N2_3_gabinete
    quien: "Elaki"
    texto: "Est\xE1n vac\xEDos."
    pensamiento: 1
  - clave: N2_3_calendario
    quien: "Elaki"
    texto: "\xBFOtra vez 31?"
    pensamiento: 1
  - clave: N2_4_foto_1
    quien: "Elaki"
    texto: "Somos los cuatro."
    pensamiento: 1
  - clave: N2_4_foto_2
    quien: "Elaki"
    texto: "Ah\xED est\xE1 ella. Yo no estaba loco."
    pensamiento: 1
  - clave: N2_6_platos_1
    quien: "Elaki"
    texto: "Cuatro platos."
    pensamiento: 1
  - clave: N2_6_platos_2
    quien: "Elaki"
    texto: "Nadie los levant\xF3."
    pensamiento: 1
  - clave: N2_8_pensamiento
    quien: "Elaki"
    texto: "No puede ser\u2026"
    pensamiento: 1
  - clave: N2_9_pensamiento
    quien: "Elaki"
    texto: "\xBFEres t\xFA?"
    pensamiento: 1
  - clave: N2_10_pensamiento
    quien: "Elaki"
    texto: "\xBFFue real\u2026 o lo so\xF1\xE9?"
    pensamiento: 1
  - clave: N2_11_lugar
    quien: "Elaki"
    texto: "Nuevamente no le sirvieron comida a M-M-A-A-R\u2026 entonces, \xBFno fue un sue\xF1o?\n\n\xBFQu\xE9 vi? No me van a creer\u2026 \xBFme estoy volviendo loco?"
    pensamiento: 1
  - clave: N2_11_madre
    quien: "Elaki"
    texto: "Ella siempre se pone triste sin raz\xF3n\u2026 y a \xE9l no le interesa nada."
    pensamiento: 1
  - clave: N2_11_comida
    quien: "Elaki"
    texto: "Esta comida no tiene sabor."
    pensamiento: 1
  - clave: N2_11_periodico
    quien: ""
    texto: "M\xE1s familias buscan a sus desaparecidos\n\nColectivos de b\xFAsqueda advierten que el registro nacional sigue creciendo."
    pensamiento: 0
  - clave: N2_11_final
    quien: "Elaki"
    texto: "No voy a dejar de buscarla."
    pensamiento: 1
  - clave: N2_12_alacena_1
    quien: "Elaki"
    texto: "Mam\xE1 guarda aqu\xED una escoba y cosas de limpieza."
    pensamiento: 1
  - clave: N2_12_alacena_2
    quien: "Elaki"
    texto: "Siempre ha estado aqu\xED\u2026 \xBFno?"
    pensamiento: 1
  - clave: N2_12_cocina
    quien: "Elaki"
    texto: "Debo volver al ba\xF1o e intentar de nuevo\u2026 \xBFy si no estoy loco?"
    pensamiento: 1
  - clave: N3_1_toallas
    quien: "Elaki"
    texto: "Siguen siendo cuatro."
    pensamiento: 1
  - clave: N3_1_tina
    quien: "Elaki"
    texto: "Mis padres nunca arreglan esa gotera."
    pensamiento: 1
  - clave: N3_1_gabinete_1
    quien: "Elaki"
    texto: "Los parches ya no est\xE1n."
    pensamiento: 1
  - clave: N3_1_gabinete_2
    quien: "Elaki"
    texto: "\xBFQui\xE9n los tir\xF3?"
    pensamiento: 1
  - clave: N3_2_toallas
    quien: "Elaki"
    texto: "Est\xE1n tibias."
    pensamiento: 1
  - clave: N3_2_gabinete
    quien: "Elaki"
    texto: "No son pastillas."
    pensamiento: 1
  - clave: N3_5_platos
    quien: "Elaki"
    texto: "Otra vez cuatro."
    pensamiento: 1
  - clave: N3_5_sillon
    quien: "Elaki"
    texto: "Respira."
    pensamiento: 1
  - clave: N3_5_anuncio
    quien: "Televisi\xF3n"
    texto: "Los trabajadores de la televisi\xF3n y la radio llevaremos a cabo nuestra 68.\xAA Asamblea General Ordinaria\n\ndel Consejo Nacional en Quintana Roo, inaugurando los trabajos del gobernador del estado,\n\ncon el respaldo de la Confederaci\xF3n de Trabajadores de M\xE9xico.\n\nAvanzamos para un futuro comprometidos contigo por una superaci\xF3n social."
    pensamiento: 0
  - clave: N3_8_pensamiento
    quien: "Elaki"
    texto: "Te encontr\xE9."
    pensamiento: 1
  - clave: D3_noticiero
    quien: "Noticiero"
    texto: "Este 25 de diciembre, la Fiscal\xEDa confirm\xF3 que el cuerpo localizado el pasado 21 de diciembre en un lote bald\xEDo\n\nen Cuautitl\xE1n Izcalli corresponde a Margarita Flores Hern\xE1ndez, de 19 a\xF1os,\n\nestudiante universitaria, desaparecida desde el 31 de octubre.\n\nSu \xFAltimo mensaje a sus padres, enviado a las 10:30 de la noche, dec\xEDa: \xABYa sal\xED de la universidad, voy para la casa\xBB.\n\nSu caso se suma al Registro Nacional de Personas Desaparecidas y No Localizadas, que ya supera las 135 mil personas;\n\nm\xE1s del 90 % de los casos son posteriores al a\xF1o 2000.\n\nEstas son solo cifras oficiales: no incluyen los casos que nunca se denunciaron."
    pensamiento: 0
  - clave: D4_texto
    quien: ""
    texto: "Autoridades de Izcalli atendieron esta noche el reporte de un joven de aproximadamente 17 a\xF1os\n\nque perdi\xF3 la vida tras ahogarse en una tina de ba\xF1o.\n\nElementos de seguridad y personal de emergencias acudieron al lugar. La Fiscal\xEDa investiga las circunstancias.\n\nHasta el momento no se ha informado su identidad."
    pensamiento: 0
  - clave: D5_cierre
    quien: ""
    texto: "El mismo d\xEDa en que confirmaron que hab\xEDan encontrado a su hermana, \xE9l dej\xF3 de buscarla."
    pensamiento: 0
  - clave: N1_OBJ_alacena_comida
    quien: "Elaki"
    texto: "Latas con el nombre borrado. No s\xE9 qu\xE9 guardan."
    pensamiento: 1
  - clave: N1_OBJ_archivero
    quien: "Elaki"
    texto: "Un caj\xF3n abierto. Adentro no hay nada."
    pensamiento: 1
  - clave: N1_OBJ_botella_pastillas
    quien: "Elaki"
    texto: "Pastillas. No recuerdo de qui\xE9n son."
    pensamiento: 1
  - clave: N1_OBJ_calendario_escritorio
    quien: "Elaki"
    texto: "Octubre. Todos los d\xEDas tachados menos uno."
    pensamiento: 1
  - clave: N1_OBJ_cazuela_barro
    quien: "Elaki"
    texto: "La cazuela de mam\xE1. Est\xE1 fr\xEDa."
    pensamiento: 1
  - clave: N1_OBJ_cesto_ropa
    quien: "Elaki"
    texto: "Ropa de alguien m\xE1s. No es m\xEDa."
    pensamiento: 1
  - clave: N1_OBJ_cesto_ropa_chico
    quien: "Elaki"
    texto: "Huele a jab\xF3n. Y a algo m\xE1s."
    pensamiento: 1
  - clave: N1_OBJ_cesto_ropa_sucia
    quien: "Elaki"
    texto: "Nadie ha lavado esto en mucho tiempo."
    pensamiento: 1
  - clave: N1_OBJ_control_remoto
    quien: "Elaki"
    texto: "El control. Aqu\xED no hay televisi\xF3n que encender."
    pensamiento: 1
  - clave: N1_OBJ_cuaderno_pendientes
    quien: "Elaki"
    texto: "Una lista de pendientes. Todos tachados."
    pensamiento: 1
  - clave: N1_OBJ_cubeta
    quien: "Elaki"
    texto: "Una cubeta vac\xEDa. Pero se oye gotear."
    pensamiento: 1
  - clave: N1_OBJ_cuchara
    quien: "Elaki"
    texto: "Una cuchara en el piso. Nadie la va a levantar."
    pensamiento: 1
  - clave: N1_OBJ_cuchillo
    quien: "Elaki"
    texto: "Mejor no lo toco."
    pensamiento: 1
  - clave: N1_OBJ_despertador_radio
    quien: "Elaki"
    texto: "Las 3:33. No avanza."
    pensamiento: 1
  - clave: N1_OBJ_dispensador_agua
    quien: "Elaki"
    texto: "El agua no se mueve. Ni una burbuja."
    pensamiento: 1
  - clave: N1_OBJ_escoba
    quien: "Elaki"
    texto: "Alguien dej\xF3 de barrer a la mitad."
    pensamiento: 1
  - clave: N1_OBJ_escritorio
    quien: "Elaki"
    texto: "Mi escritorio. \xBFQu\xE9 hace aqu\xED?"
    pensamiento: 1
  - clave: N1_OBJ_estufa
    quien: "Elaki"
    texto: "Apagada. Todav\xEDa huele a comida."
    pensamiento: 1
  - clave: N1_OBJ_lampara
    quien: "Elaki"
    texto: "Est\xE1 prendida. No est\xE1 conectada a nada."
    pensamiento: 1
  - clave: N1_OBJ_lampara_buro
    quien: "Elaki"
    texto: "La l\xE1mpara de mi bur\xF3. Sin bur\xF3."
    pensamiento: 1
  - clave: N1_OBJ_lampara_lectura
    quien: "Elaki"
    texto: "Alguien le\xEDa aqu\xED."
    pensamiento: 1
  - clave: N1_OBJ_lapicero
    quien: "Elaki"
    texto: "Mis plumas. Las mismas de siempre."
    pensamiento: 1
  - clave: N1_OBJ_lavadero
    quien: "Elaki"
    texto: "El agua lleva d\xEDas estancada."
    pensamiento: 1
  - clave: N1_OBJ_lavadora
    quien: "Elaki"
    texto: "No est\xE1 girando. Se oye como si girara."
    pensamiento: 1
  - clave: N1_OBJ_lavadoras_centro
    quien: "Elaki"
    texto: "\xBFPara qu\xE9 querr\xEDa alguien tantas lavadoras?"
    pensamiento: 1
  - clave: N1_OBJ_lavamanos
    quien: "Elaki"
    texto: "El lavamanos est\xE1 seco."
    pensamiento: 1
  - clave: N1_OBJ_lavaplatos
    quien: "Elaki"
    texto: "No hay platos. Nadie comi\xF3 aqu\xED."
    pensamiento: 1
  - clave: N1_OBJ_libro_azul
    quien: "Elaki"
    texto: "No puedo leer el t\xEDtulo."
    pensamiento: 1
  - clave: N1_OBJ_libro_rojo
    quien: "Elaki"
    texto: "Este libro era de ella. Creo."
    pensamiento: 1
  - clave: N1_OBJ_libro_verde
    quien: "Elaki"
    texto: "Las p\xE1ginas est\xE1n en blanco."
    pensamiento: 1
  - clave: N1_OBJ_libros
    quien: "Elaki"
    texto: "Libros apilados. Ninguno tiene nombre."
    pensamiento: 1
  - clave: N1_OBJ_mesa_comedor_enterrada
    quien: "Elaki"
    texto: "La mesa se est\xE1 hundiendo. O el piso est\xE1 subiendo."
    pensamiento: 1
  - clave: N1_OBJ_mesita_redonda
    quien: "Elaki"
    texto: "Una mesita sola, en medio de nada."
    pensamiento: 1
  - clave: N1_OBJ_olla_aluminio
    quien: "Elaki"
    texto: "Una olla vac\xEDa."
    pensamiento: 1
  - clave: N1_OBJ_olla_barro
    quien: "Elaki"
    texto: "Aqu\xED se hac\xEDan los frijoles."
    pensamiento: 1
  - clave: N1_OBJ_olla_express
    quien: "Elaki"
    texto: "Me daba miedo cuando silbaba."
    pensamiento: 1
  - clave: N1_OBJ_olla_peltre_azul
    quien: "Elaki"
    texto: "El peltre azul de la abuela."
    pensamiento: 1
  - clave: N1_OBJ_olla_tamalera
    quien: "Elaki"
    texto: "La tamalera solo sale en diciembre."
    pensamiento: 1
  - clave: N1_OBJ_pc_torre
    quien: "Elaki"
    texto: "Zumba, pero no tiene pantalla."
    pensamiento: 1
  - clave: N1_OBJ_plato
    quien: "Elaki"
    texto: "Un plato limpio. Sobra uno."
    pensamiento: 1
  - clave: N1_OBJ_plato_espagueti
    quien: "Elaki"
    texto: "Est\xE1 fr\xEDo. Las moscas llegaron primero."
    pensamiento: 1
  - clave: N1_OBJ_plato_huevo_a_la_mexicana
    quien: "Elaki"
    texto: "El desayuno de alguien. No el m\xEDo."
    pensamiento: 1
  - clave: N1_OBJ_plato_pollo_frito
    quien: "Elaki"
    texto: "Nadie se lo termin\xF3."
    pensamiento: 1
  - clave: N1_OBJ_plato_sopa_fideo
    quien: "Elaki"
    texto: "Sopa de fideo. Ya tiene nata."
    pensamiento: 1
  - clave: N1_OBJ_plato_tacos_pastor
    quien: "Elaki"
    texto: "Sus favoritos."
    pensamiento: 1
  - clave: N1_OBJ_platos_grupo
    quien: "Elaki"
    texto: "Cuatro platos. Siempre fueron cuatro."
    pensamiento: 1
  - clave: N1_OBJ_poster_tirado
    quien: "Elaki"
    texto: "Se cay\xF3 de la pared. O alguien lo arranc\xF3."
    pensamiento: 1
  - clave: N1_OBJ_raton
    quien: "Elaki"
    texto: "El rat\xF3n de mi computadora. Sin computadora."
    pensamiento: 1
  - clave: N1_OBJ_refrigerador
    quien: "Elaki"
    texto: "No quiero abrirlo."
    pensamiento: 1
  - clave: N1_OBJ_retrete
    quien: "Elaki"
    texto: "Demasiado limpio."
    pensamiento: 1
  - clave: N1_OBJ_ropero
    quien: "Elaki"
    texto: "El ropero. No recuerdo qu\xE9 guard\xE1bamos arriba."
    pensamiento: 1
  - clave: N1_OBJ_sarten
    quien: "Elaki"
    texto: "Todav\xEDa tiene aceite."
    pensamiento: 1
  - clave: N1_OBJ_secadora
    quien: "Elaki"
    texto: "Est\xE1 tibia. Alguien la us\xF3 hace poco."
    pensamiento: 1
  - clave: N1_OBJ_silla_oficina
    quien: "Elaki"
    texto: "La silla gira sola. Un poco."
    pensamiento: 1
  - clave: N1_OBJ_sillaescritorio
    quien: "Elaki"
    texto: "Mi silla. Lejos de mi escritorio."
    pensamiento: 1
  - clave: N1_OBJ_taza_cafe
    quien: "Elaki"
    texto: "El caf\xE9 de pap\xE1. Sigue caliente."
    pensamiento: 1
  - clave: N1_OBJ_teclado
    quien: "Elaki"
    texto: "Faltan teclas. Justo las de su nombre."
    pensamiento: 1
  - clave: N1_OBJ_television_antigua
    quien: "Elaki"
    texto: "Apagada. Me veo reflejado. Solo yo."
    pensamiento: 1
  - clave: N1_OBJ_vaso
    quien: "Elaki"
    texto: "Un vaso de agua a medias."
    pensamiento: 1
  - clave: N1_OBJ_vitrina_antigua
    quien: "Elaki"
    texto: "Los vidrios est\xE1n oscuros. No se ve qu\xE9 hay adentro."
    pensamiento: 1
